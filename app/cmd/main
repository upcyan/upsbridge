#!/bin/bash
# upsbridge —— fnOS 应用生命周期入口
# 由 fnOS 以 root 调用：cmd/main start|stop|status|restart|log
#
# 安装后布局：
#   /var/apps/upsbridge/cmd/main        本脚本
#   /var/apps/upsbridge/target/         <- app.tgz 解压到此
#   /var/apps/upsbridge/target/upsbridge/upsbridge.py
#   /var/apps/upsbridge/target/ui/      桌面入口
#   /vol1/@appdata/upsbridge/           -> var/
#
# 权限模型（本版起）：
#   本脚本以 root 运行，只负责起停。
#   - 一个极小的 root 助手（privileged.py）只做 ping 与关机两件事；
#   - 前台服务降权到 $APP_USER 跑，Web 与配置读写都不再有 root 权限。
#   任一环节不可用（没这个用户、没 setpriv），退回 root 直跑，功能不降级。
set -u

# fnOS 调用生命周期脚本时不保证 PATH（见 CyanNVR 踩坑注释），显式补上
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
APP_HOME="$(dirname "$SCRIPT_DIR")"

PY=""
for c in /usr/bin/python3 /var/apps/python312/target/bin/python3 python3; do
  if command -v "$c" >/dev/null 2>&1; then PY="$c"; break; fi
done
[ -n "$PY" ] || { echo "找不到 python3" >&2; exit 1; }

VAR="$APP_HOME/var"; RUN="$VAR/run"; LOG="$VAR/log"; ETC="$APP_HOME/etc"
mkdir -p "$RUN" "$LOG" "$ETC"

PIDFILE="$RUN/app.pid"
HELPER_PIDFILE="$RUN/priv.pid"
PORT="${UPSBRIDGE_PORT:-28190}"
APP="$APP_HOME/target/upsbridge/upsbridge.py"
CONF="$ETC/config.json"
HELPER_SRC="$APP_HOME/target/upsbridge/privileged.py"
# 桌面网关 socket：trim_http_cgi 以 root 把 /app/upsbridge/* 经它转发进服务
GATEWAY_SOCK="$APP_HOME/target/upsbridge.sock"
# 助手副本只从 root 专属目录运行：应用目录归应用用户，若直接从那儿跑，
# 任何能改应用目录的人就等于能改一段以 root 执行的脚本。
PRIV_DIR="$ETC/priv"
HELPER="$PRIV_DIR/privileged.py"
PRIV_SOCK="$RUN/priv.sock"
APP_USER="${UPSBRIDGE_USER:-upsbridge}"

log() { printf "[upsbridge] %s\n" "$*"; }

# 应用用户：fnOS 安装时按 config/privilege 的 username 建好。
# 取不到 uid 或没有 setpriv 就退回 root 直跑 —— 宁可少一层防护也不能起不来。
app_uid() { getent passwd "$APP_USER" 2>/dev/null | cut -d: -f3; }
app_gid() { getent passwd "$APP_USER" 2>/dev/null | cut -d: -f4; }

drop_priv_available() {
  [ -n "$(app_uid)" ] || return 1
  command -v setpriv >/dev/null 2>&1 || return 1
  return 0
}

# 端口探活：不依赖 curl，/dev/tcp 是 bash 内建的
port_open() {
  (exec 3<>"/dev/tcp/127.0.0.1/$PORT") 2>/dev/null || return 1
  exec 3>&- 3<&-
  return 0
}

pid_from_file() {
  [ -f "$PIDFILE" ] || return 1
  local p; p="$(tr -dc '0-9' < "$PIDFILE" 2>/dev/null)"
  [ -n "$p" ] || return 1
  printf '%s' "$p"
}

# 判定「本应用真的在跑」。
# ⚠️ 只判断 /proc/<pid> 是否存在是不够的：pid 会被系统复用。实测重启后 pidfile 里
# 的 6088 被 trim-preview-server 顶替，status 于是永远谎报 running，应用中心认为
# 服务健在、从不重拉，桌面打开时后端不可达 -> 显示「FN Connect 暂无权限访问该服务」。
# 因此必须确认该 pid 的命令行确实是 upsbridge.py。
is_running() {
  local pid; pid="$(pid_from_file)" || return 1
  [ -d "/proc/$pid" ] || return 1
  [ -r "/proc/$pid/cmdline" ] || return 1
  tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q "upsbridge.py"
}

# 开机/安装自愈：应用中心拉起失败时的兜底单元。
# 为什么放在这里而不是只放 install_callback：实测 1.0.1 安装时应用中心并没有
# 覆盖 cmd/install_callback（只有 main 与 upsbridge.py 被换掉），于是依赖它的
# 兜底单元永远不会被创建。start 由应用中心以 root 调用，是最稳定的落点。
# 只做「写单元 + enable」，绝不 --now：此刻 do_start 正跑到一半，--now 会递归。
UNIT="/etc/systemd/system/upsbridge-fpk.service"
ensure_unit() {
  [ "$(id -u)" = "0" ] || return 0
  command -v systemctl >/dev/null 2>&1 || return 0
  local want
  want="[Unit]
Description=upsbridge fpk 应用（UPS 断电联动）
# 应用中心开机也会按 DB 状态拉起应用；本单元是兜底：
# 若走应用中心路径失败（例如 status 判定异常、批量启动被跳过），进程仍能起来。
# 两边都启动时 start 幂等（端口探活 + pid 校验），不会重复拉。
After=network-online.target trim_app_center.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/var/apps/upsbridge/cmd/main start
ExecStop=/var/apps/upsbridge/cmd/main stop
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target"
  if [ "$(cat "$UNIT" 2>/dev/null)" != "$want" ]; then
    printf '%s\n' "$want" > "$UNIT" 2>/dev/null && systemctl daemon-reload >/dev/null 2>&1 || true
  fi
  systemctl is-enabled upsbridge-fpk.service >/dev/null 2>&1 || systemctl enable upsbridge-fpk.service >/dev/null 2>&1 || true
}

# 部署 root 助手：副本落在 $ETC/priv（root:root 700）。
deploy_helper() {
  [ "$(id -u)" = "0" ] || return 1
  [ -f "$HELPER_SRC" ] || return 1
  mkdir -p "$PRIV_DIR" 2>/dev/null || return 1
  if ! cmp -s "$HELPER_SRC" "$HELPER" 2>/dev/null; then
    cp -f "$HELPER_SRC" "$HELPER" 2>/dev/null || return 1
  fi
  chown root:root "$PRIV_DIR" "$HELPER" 2>/dev/null
  chmod 700 "$PRIV_DIR" 2>/dev/null
  chmod 700 "$HELPER" 2>/dev/null
  return 0
}

start_helper() {
  [ "$(id -u)" = "0" ] || return 1
  drop_priv_available || return 1
  deploy_helper || return 1
  command -v "$PY" >/dev/null 2>&1 || return 1
  rm -f "$PRIV_SOCK" 2>/dev/null
  local gid_group
  gid_group="$(getent group "$APP_USER" 2>/dev/null | cut -d: -f1)"
  setsid "$PY" "$HELPER" --socket "$PRIV_SOCK" \
      --group "$gid_group" --allow-uid "$(app_uid)" \
      < /dev/null >> "$LOG/priv.log" 2>&1 &
  local pid=$!
  echo "$pid" > "$HELPER_PIDFILE"
  local i=0
  while [ $i -lt 20 ]; do
    [ -S "$PRIV_SOCK" ] && { log "特权助手已就绪 (pid $pid)"; return 0; }
    sleep 0.25; i=$((i+1))
  done
  log "特权助手启动失败，退回 root 直跑"
  rm -f "$HELPER_PIDFILE" "$PRIV_SOCK" 2>/dev/null
  return 1
}

do_start() {
  ensure_unit
  if port_open; then
    if is_running; then log "已在运行 (pid $(pid_from_file), :$PORT)"; else log "端口 :$PORT 已被其他进程占用"; fi
    return 0
  fi
  if is_running; then
    log "pid $(pid_from_file) 存活但 :$PORT 无响应，先清理"
    do_stop
  fi
  rm -f "$PIDFILE" "$GATEWAY_SOCK" 2>/dev/null
  if [ ! -f "$APP" ]; then log "找不到主程序 $APP"; return 1; fi
  [ -f "$CONF" ] || cp "$APP_HOME/target/upsbridge/config.default.json" "$CONF"

  # 降权前提：目录得让应用用户写得进去，否则配置和日志都存不下
  local use_drop=0
  if drop_priv_available; then
    chown -R "$(app_uid):$(app_gid)" "$VAR" "$ETC" 2>/dev/null || true
    [ -f "$CONF" ] && chown "$(app_uid):$(app_gid)" "$CONF" 2>/dev/null || true
    chmod 750 "$VAR" "$ETC" 2>/dev/null || true
    use_drop=1
  else
    log "没有 $APP_USER 用户或 setpriv，本次以 root 运行"
  fi

  local priv_args=()
  if [ "$use_drop" = "1" ]; then
    if start_helper; then
      priv_args=(--priv-sock "$PRIV_SOCK")
    else
      use_drop=0
      log "助手不可用，本次以 root 运行"
    fi
  fi

  # setsid：把服务放进独立会话/进程组。
  # ⚠️ 实测 1.0.1 装好后 19 秒进程凭空消失、事件日志记 APP_CRASH，app.log 里既没有
  # 异常也没有退出记录（stdout.log 一个字节没写）—— 那是被信号杀掉的典型特征：
  # 应用中心拉起应用后按进程组回收，nohup 只挡 SIGHUP、挡不住整组 SIGTERM。
  # setsid 之后本进程组不再等于调用方，收不到这种连带信号。
  if [ "$use_drop" = "1" ]; then
    setsid setpriv --reuid "$(app_uid)" --regid "$(app_gid)" --init-groups \
        "$PY" "$APP" --config "$CONF" --port "$PORT" --log "$LOG/app.log" "${priv_args[@]}" \
        --gateway-sock "$GATEWAY_SOCK" "${priv_args[@]}" \
        < /dev/null >> "$LOG/stdout.log" 2>&1 &
  elif command -v setsid >/dev/null 2>&1; then
    setsid "$PY" "$APP" --config "$CONF" --port "$PORT" --log "$LOG/app.log" \
        < /dev/null >> "$LOG/stdout.log" 2>&1 &
  else
    nohup "$PY" "$APP" --config "$CONF" --port "$PORT" --log "$LOG/app.log" \
        < /dev/null >> "$LOG/stdout.log" 2>&1 &
  fi
  local pid=$!
  disown 2>/dev/null || true
  # setsid 有时会 fork 一次，$! 未必是真身；以命令行反查实际 pid，取最新一个
  local real
  real="$(pgrep -n -f "$APP" 2>/dev/null || true)"
  [ -n "$real" ] && pid="$real"
  echo "$pid" > "$PIDFILE"
  local i=0
  while [ $i -lt 15 ]; do
    if port_open; then
      log "已启动 (pid $pid, :$PORT, 用户 $( [ "$use_drop" = "1" ] && echo "$APP_USER" || echo root ))"
      return 0
    fi
    [ -d "/proc/$pid" ] || break
    sleep 1; i=$((i+1))
  done
  log "启动失败，最近日志："; tail -n 20 "$LOG/app.log" 2>/dev/null
  [ -d "/proc/$pid" ] || rm -f "$PIDFILE"
  return 1
}

do_stop() {
  local pid; pid="$(pid_from_file)" || pid=""
  if [ -n "$pid" ] && is_running; then
    kill "$pid" 2>/dev/null
    local i=0
    while [ $i -lt 10 ] && [ -d "/proc/$pid" ]; do sleep 1; i=$((i+1)); done
    [ -d "/proc/$pid" ] && kill -9 "$pid" 2>/dev/null
  fi
  # 兜底：pidfile 丢失/失效时按命令行清理残留进程，避免端口被占着起不来
  pkill -f "$APP" 2>/dev/null
  rm -f "$GATEWAY_SOCK" 2>/dev/null
  rm -f "$PIDFILE"

  local hpid; hpid="$(tr -dc '0-9' < "$HELPER_PIDFILE" 2>/dev/null)"
  if [ -n "$hpid" ] && [ -d "/proc/$hpid" ]; then
    kill "$hpid" 2>/dev/null
    sleep 1
    [ -d "/proc/$hpid" ] && kill -9 "$hpid" 2>/dev/null
  fi
  pkill -f "$HELPER" 2>/dev/null
  rm -f "$HELPER_PIDFILE" "$PRIV_SOCK"
  log "已停止"
}

# 状态以端口为准：pidfile 只是线索。
# 只有端口真的在响应才算 running —— 宁可多报一次 stopped 让应用中心重拉，
# 也不要谎报 running 导致服务永久不启动。
do_status() {
  if port_open; then echo "running"; exit 0; fi
  if is_running; then
    local pid age
    pid="$(pid_from_file)"
    age=$(( $(date +%s) - $(stat -c %Y "$PIDFILE" 2>/dev/null || echo 0) ))
    if [ "$age" -lt 20 ]; then echo "running"; exit 0; fi
    log "pid $pid 存活但 :$PORT 无响应（pidfile 已 $age 秒），判定为异常并清理"
  fi
  rm -f "$PIDFILE"
  echo "stopped"; exit 3
}

case "${1:-}" in
  start)   do_start ;;
  stop)    do_stop ;;
  restart) do_stop; do_start ;;
  status)  do_status ;;
  log)     tail -n "${2:-100}" "$LOG/app.log" ;;
  *)       echo "usage: $0 start|stop|restart|status|log" >&2; exit 1 ;;
esac
